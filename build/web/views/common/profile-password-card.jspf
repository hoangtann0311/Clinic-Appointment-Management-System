<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%--
    Card "Bảo Mật Tài Khoản" + modal Đổi Mật Khẩu, dùng chung cho trang Hồ Sơ Cá Nhân
    của Bác sĩ siêu âm, Nhân viên lễ tân và Quản lý.

    Không tự xử lý mật khẩu: form POST thẳng sang /change-password sẵn có, với đúng
    ba tên tham số mà ChangePasswordServlet đang đọc (oldPassword, newPassword,
    confirmPassword) cộng redirectTo. Giữ nguyên cách trang hồ sơ Bác sĩ lâm sàng làm.

    CÁCH DÙNG — đặt biến đường dẫn quay lại rồi include:

        <c:set var="pfPasswordRedirect" value="${pageContext.request.contextPath}/sonographer/profile" />
        <%@ include file="../common/profile-password-card.jspf" %>
--%>
<div class="card admin-card fade-in-up mt-4">
    <div class="card-header">
        <h5><i class="bi bi-shield-lock"></i>Bảo Mật Tài Khoản</h5>
    </div>
    <div class="card-body" style="padding: 1.5rem !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <p class="mb-1 fw-medium">Mật khẩu đăng nhập</p>
                <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Nên đổi mật khẩu định kỳ để bảo vệ tài khoản.
                    Mật khẩu mới phải có ít nhất 6 ký tự.
                </p>
            </div>
            <button type="button" class="btn btn-outline-warning rounded-pill px-4 fw-semibold"
                    data-bs-toggle="modal" data-bs-target="#pfChangePasswordModal">
                <i class="bi bi-key me-1"></i>Đổi Mật Khẩu
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="pfChangePasswordModal" tabindex="-1"
     aria-labelledby="pfChangePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0"
                 style="background:linear-gradient(135deg,#7c3aed,#6d28d9);border-radius:1rem 1rem 0 0;">
                <h5 class="modal-title fw-bold text-white" id="pfChangePasswordModalLabel">
                    <i class="bi bi-shield-lock-fill me-2"></i>Đổi Mật Khẩu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="${pageContext.request.contextPath}/change-password"
                  id="pfChangePasswordForm" novalidate>
                <input type="hidden" name="_csrf" value="${fn:escapeXml(sessionScope.csrfToken)}">
                <div class="modal-body p-4">

                    <c:if test="${not empty param.pwError}">
                        <div class="alert alert-danger small py-2">
                            <i class="bi bi-exclamation-triangle me-1"></i><c:out value="${param.pwError}" />
                        </div>
                    </c:if>
                    <c:if test="${not empty param.pwSuccess}">
                        <div class="alert alert-success small py-2">
                            <i class="bi bi-check-circle me-1"></i><c:out value="${param.pwSuccess}" />
                        </div>
                    </c:if>

                    <div class="mb-3">
                        <label for="pfOldPassword" class="form-label fw-semibold">
                            Mật khẩu hiện tại <span class="text-danger">*</span>
                        </label>
                        <input type="password" id="pfOldPassword" name="oldPassword"
                               class="form-control" placeholder="Nhập mật khẩu hiện tại"
                               required autocomplete="current-password">
                    </div>

                    <div class="mb-3">
                        <label for="pfNewPassword" class="form-label fw-semibold">
                            Mật khẩu mới <span class="text-danger">*</span>
                        </label>
                        <input type="password" id="pfNewPassword" name="newPassword"
                               class="form-control" placeholder="Tối thiểu 6 ký tự"
                               required minlength="6" autocomplete="new-password">
                    </div>

                    <div class="mb-3">
                        <label for="pfConfirmPassword" class="form-label fw-semibold">
                            Xác nhận mật khẩu mới <span class="text-danger">*</span>
                        </label>
                        <input type="password" id="pfConfirmPassword" name="confirmPassword"
                               class="form-control" placeholder="Nhập lại mật khẩu mới"
                               required minlength="6" autocomplete="new-password">
                    </div>

                    <%-- Quay lại đúng trang hồ sơ của vai trò đang dùng fragment này --%>
                    <input type="hidden" name="redirectTo" value="${fn:escapeXml(pfPasswordRedirect)}">
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill"
                            data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill fw-semibold px-4">
                        <i class="bi bi-check-circle me-1"></i>Xác nhận đổi mật khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
  /* Đổi mật khẩu thất bại: ChangePasswordServlet redirect về ?pwError=…
     Thông báo lỗi nằm TRONG modal, nên phải mở lại modal thì người dùng mới thấy.
     Không có đoạn này thì trang chỉ tải lại và trông như không có gì xảy ra.

     Đặt trong fragment để cả ba vai trò dùng chung đều có, không phải chép lại.
     Chạy trong DOMContentLoaded nên Bootstrap (nạp ở cuối body) đã sẵn sàng. */
  document.addEventListener('DOMContentLoaded', function () {
    var hasPwMsg = ${not empty param.pwError || not empty param.pwSuccess ? 'true' : 'false'};
    if (!hasPwMsg) return;
    var modalEl = document.getElementById('pfChangePasswordModal');
    if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
  });
</script>
